# --- BACKEND TOGGLE ---------------------------------------------------------
# 1 = use the real Postgres + API. Anything else = localStorage demo per browser.
NEXT_PUBLIC_HAS_BACKEND=0

# --- DATABASE ---------------------------------------------------------------
# Connection pooler URL from Neon / Supabase / Vercel Postgres.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Some providers (Neon) also expose a direct (non-pooled) URL for migrations.
# DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- SECURITY ---------------------------------------------------------------
# >=32 random chars in production. Used to sign the admin JWT cookie.
JWT_SECRET="change-me-to-a-long-random-string-32+chars"
# >=16 random chars in production. Server-side pepper for hashing voter
# email/phone before storage. Rotating this invalidates "already voted" checks.
VOTER_ID_PEPPER="another-long-secret-16+chars"

# --- FIRST ADMIN (read by `npm run db:seed` only when no admin exists) ------
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-before-going-live"
ADMIN_DISPLAY_NAME="Administrator"
