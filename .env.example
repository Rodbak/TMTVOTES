# Public site: in `npm run dev`, mock topics are used by default (no Postgres).
# For local full stack with a real database, set:
# NEXT_PUBLIC_PRESENTATION_MODE=0
#
# For a production *build* that should still show mock data only, set:
# NEXT_PUBLIC_PRESENTATION_MODE=1

# Canonical site URL for Open Graph (must include scheme, e.g. https://)
# Wrong values here can break the page <title> in the browser tab.
# NEXT_PUBLIC_APP_URL="https://your-domain.com"

# PostgreSQL — only needed when NEXT_PUBLIC_PRESENTATION_MODE=0 (or production build)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tmtvotes?schema=public"

# Used to sign admin JWT (min 32 random chars in production)
JWT_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Server-side pepper for hashing voter email/phone (never commit real prod value)
VOTER_ID_PEPPER="replace-with-another-long-secret"

# First admin user (used only by prisma/seed when DB is empty)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-immediately"
ADMIN_DISPLAY_NAME="Administrator"
